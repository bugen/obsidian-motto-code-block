{
  "name": "obsidian-motto-codeblock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Focused code block enhancements for Obsidian.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:languages": "node scripts/generate-languages.ts"
  },
  "dependencies": {
    "@lezer/markdown": "^1.8.1",
    "anser": "^2.3.5",
    "ansi-regex": "^6.6.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "^1.5.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
